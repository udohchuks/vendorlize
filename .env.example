# Copy this file to .env.local for local development.
# In production (Vercel / Netlify / etc.), add these as Environment Variables in your dashboard.

# ── API ──────────────────────────────────────────────────────────────
# Base URL of the hackathon merchant API.
# IMPORTANT: Must NOT have a trailing slash.
NEXT_PUBLIC_API_BASE_URL=https://api-hackathon.codedematrixtech.com

# ── TEAM ─────────────────────────────────────────────────────────────
# Your registered team slug (must match what you used in POST /teams).
NEXT_PUBLIC_TEAM_SLUG=phasion-sense

# ── MERCHANTS ────────────────────────────────────────────────────────
# Comma-separated list of merchant slugs whose items/campaigns to show.
NEXT_PUBLIC_MERCHANTS=phasion-sense,amina-stitches,kofi-menswear

# ── AI API KEYS ──────────────────────────────────────────────────────
# Agnes AI API Key (obtain from platform.agnes-ai.com)
AGNES_API_KEY="YOUR_API_KEY"
